<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8" />
  <% if (htmlWebpackPlugin.options.isDevelopment) { %>
    <meta http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws: localhost:* https://*.supabase.co;" />
  <% } else { %>
    <meta http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co;" />
  <% } %>
  <title>A POS System</title>
</head>

<body>
  <div id="root"></div>
</body>

</html>